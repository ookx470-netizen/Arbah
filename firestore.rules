rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Deposits collection rules
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdrawals collection rules
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Tasks collection rules
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Support Chats collection rules
    match /support_chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Notifications collection rules
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Group Chat Messages collection rules
    match /group_chat_messages/{messageId} {
      allow read, write: if true;
    }
  }
}
